# RevOps Hub — environment variables
# Copy this to .env.local and fill in values
# Never commit .env.local to Git

# Sales Jarvis — n8n webhook that handles Ask Anything presets
NEXT_PUBLIC_JARVIS_WEBHOOK=https://certifyos.app.n8n.cloud/webhook/YOUR_JARVIS_WEBHOOK_ID

# Engine 1 / Command Center — existing Vercel deploy URL
NEXT_PUBLIC_ENGINE1_URL=https://n8n-sales-usecase.vercel.app

# RFP Assistant — existing Vercel deploy URL
NEXT_PUBLIC_RFP_URL=https://certifyos-rfp-assistant.vercel.app

# ROI Model — existing Vercel deploy URL
NEXT_PUBLIC_ROI_URL=https://certifyos-roi-model-request-certify-os.vercel.app
